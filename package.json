{
  "name": "wallabag-cf-worker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/auth",
    "packages/parser",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20260610.1",
    "hono": "^4.13.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
