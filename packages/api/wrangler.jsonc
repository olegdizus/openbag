{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbag-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "vars": {
    "ALLOWED_REGISTRATION": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbag-db",
      "database_id": "REDACTED-D1-ID"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ENTRY_REFETCH", "queue": "entry-refetch" }
    ],
    "consumers": [
      { "queue": "entry-refetch", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *", "0 3 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
  // Static assets live in packages/web-gui/public — the API Worker has no ASSETS binding.
}
