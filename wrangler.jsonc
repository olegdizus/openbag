{
  "name": "wallabag",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-10",
  "alias": {
    "@wallabag/core": "./packages/core/src/index.ts",
    "@wallabag/auth": "./packages/auth/src/index.ts",
    "@wallabag/parser": "./packages/parser/src/index.ts",
    "@wallabag/api": "./packages/api/src/index.ts",
    "@wallabag/web": "./packages/web/src/index.ts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallabag-db",
      "database_id": "REDACTED-D1-ID"
    }
  ],
  "queues": {
    "consumers": [
      { "queue": "entry-refetch", "max_batch_size": 10, "max_retries": 3 },
      { "queue": "token-cleanup", "max_batch_size": 50 },
      { "queue": "import", "max_batch_size": 5, "max_retries": 5 }
    ]
  },
  "browser": { "binding": "BROWSER" },
  "triggers": {
    "crons": ["0 * * * *", "0 3 * * *", "0 0 * * SUN"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./packages/web/public"
  }
}
