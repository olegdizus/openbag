{
  "name": "openbag",
  "main": "worker/src/entrypoint.ts",
  "compatibility_date": "2026-06-10",
  "vars": {
    "ALLOWED_REGISTRATION": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbag-db",
      "database_id": "REDACTED-D1-ID"
    }
  ],
  "queues": {
    "consumers": [
      { "queue": "entry-refetch", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *", "0 3 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./web-ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
