{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "esnext"
    ],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@openbag/core": ["packages/core/src"],
      "@openbag/auth": ["packages/auth/src"],
      "@openbag/parser": ["packages/parser/src"],
      "@openbag/api": ["packages/api/src"],
      "@openbag/web": ["packages/web/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
