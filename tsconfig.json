{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "esnext"
    ],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@openbag/worker": ["worker/src"],
      "@openbag/worker/auth": ["worker/src/auth"],
      "@openbag/worker/parser": ["worker/src/parser"],
      "@openbag/worker/sanitize": ["worker/src/sanitize"]
    }
  },
  "include": [
    "worker/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
