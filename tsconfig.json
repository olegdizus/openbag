{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "esnext"
    ],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers", "node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@openbag/core": ["./packages/core/src/index.ts"],
      "@openbag/core/wire": ["./packages/core/src/wire-types.ts"],
      "@openbag/core/db": ["./packages/core/src/db/index.ts"],
      "@openbag/api": ["./packages/api/src/index.ts"],
      "@openbag/web-gui": ["./packages/web-gui/src/index.ts"]
    }
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/api/**/*.ts",
    "packages/api/**/*.tsx",
    "packages/web-gui/**/*.ts",
    "packages/web-gui/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/web-gui/public",
    "packages/web-gui/src/components",
    "packages/web-gui/src/entrypoints",
    "packages/web-gui/src/lib"
  ]
}
