{
  "compilerOptions": {
    "strict": true,
    "target": "es2025",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}